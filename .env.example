# Copy this file to .env and fill in your real values.
# The real .env is ignored by git and NEVER pushed to GitHub.

# --- Core / users database ---
# Use a MongoDB Atlas connection string here for production, e.g.
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/fruit-shop
MONGODB_URI=mongodb://127.0.0.1:27017/fruit-shop
JWT_SECRET=change-me-to-a-long-random-string
PORT=3000
ADMIN_PASSWORD=change-me
CLIENT_URL=http://localhost:3000

# --- Orders database (kept separate from the users database) ---
# Point this at a DIFFERENT database name than MONGODB_URI, e.g. same Atlas
# cluster but .../fruit-shop-orders instead of .../fruit-shop. If left blank
# it falls back to MONGODB_URI.
ORDERS_MONGODB_URI=mongodb://127.0.0.1:27017/fruit-shop-orders

# --- Social login ---
# Facebook: create an app at https://developers.facebook.com/apps
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Callback for the sign-in AND sign-up Facebook buttons. Must match the
# "Valid OAuth Redirect URIs" you register in your Facebook app exactly,
# e.g. http://localhost:3000/api/auth/facebook/callback
FACEBOOK_CALLBACK_URL=
# Twitter/X: create an app at https://developer.x.com and set up
# "User authentication settings" with OAuth 2.0 (PKCE). Use the
# Client ID and Client Secret shown there (NOT the API Key/API Secret).
# Set "Callback URL" there to http://localhost:3000/api/auth/twitter/callback
# (or use TWITTER_CALLBACK_URL below if you need something different).
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TWITTER_CALLBACK_URL=
# Instagram: separate login flow ("Instagram API with Instagram Login", OAuth 2.0).
# Reuses the Facebook App credentials by default (Instagram is a product inside
# your Facebook app) - INSTAGRAM_CLIENT_ID/SECRET are only needed to override.
# Your Facebook app needs the Instagram product enabled, and only Professional
# (Business/Creator) accounts can sign in. Set "Valid OAuth Redirect URIs" in
# Facebook App Settings -> Instagram to http://localhost:3000/api/auth/instagram/callback
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_CALLBACK_URL=

# --- WhatsApp admin notifications (Twilio) ---
# 1. Create a free account at https://www.twilio.com
# 2. In the Console, enable the WhatsApp Sandbox (Messaging -> Try it out ->
#    Send a WhatsApp message). It gives you a sandbox number, e.g. +14155238886,
#    and a join code. Recipients opt in by sending "join <code>" to it.
# 3. TWILIO_ACCOUNT_SID / TWILIO_AUTH_TOKEN: shown on the Console dashboard.
# 4. TWILIO_WHATSAPP_FROM: the Twilio WhatsApp number (e.g. +14155238886 in
#    sandbox, or your approved business number in production).
# 5. TWILIO_WHATSAPP_CONTENT_SID (HX...): REQUIRED since April 2025 - Twilio
#    rejects plain `body` WhatsApp messages for business-initiated messages
#    with error 21654 "ContentSid Required". Create an approved Content
#    Template (Console > Messaging > Content Template Builder) whose body is
#    just "{{1}}" and paste its SID here. NOTE: the Sandbox only allows its 3
#    pre-approved templates, so for real notifications register a WhatsApp
#    sender (Self Sign-up) and use a custom template. If left blank the app
#    falls back to `body`, which only works inside the 24-hour window.
# ADMIN_WHATSAPP_NUMBER is who receives order/signup alerts. Include the country
# code without '+' (India is 91): 918270703110. Multiple numbers are allowed as
# a comma-separated list, e.g. "918637407913,918270703110".
# WHATSAPP_COUNTRY_CODE (default 91) is only used to expand a bare 10-digit
# ADMIN_WHATSAPP_NUMBER.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_WHATSAPP_CONTENT_SID=
ADMIN_WHATSAPP_NUMBER=
WHATSAPP_COUNTRY_CODE=91

# --- Forgot-password email (SMTP) ---
# Example values for Gmail: EMAIL_HOST=smtp.gmail.com, EMAIL_PORT=587,
# EMAIL_USER=you@gmail.com, EMAIL_PASS=<a 16-character Gmail App Password>
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=S.L.A Fruit Shop <no-reply@fruitshop.local>
